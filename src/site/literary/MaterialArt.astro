---
import { artworks } from './artworks';
interface Props {
    piece: number;
    prefix: string;
    large?: boolean;
    decorative?: boolean;
}
const { piece, prefix, large = false, decorative = false } = Astro.props;
const artwork = artworks[piece];
if (!artwork)
    throw new Error(`Unknown artwork slot: ${piece}`);
const uid = prefix.replace(/[^a-zA-Z0-9_-]/g, '-');
const asset = (size: number) => '/literary/art/material/' + artwork.slug + '-' + size + '.webp';
const [x, y, r] = artwork.light[0];
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox={prefix.startsWith('preview')?'0 25 640 450':'0 0 640 500'} class="literary-art material-print" data-piece={piece} data-art-state="loading" data-material-base={asset(320)} data-material-src={asset(960)} data-material-hires={asset(1536)} data-material-upgrade={large?'true':undefined} data-light-0={artwork.light[0].join(' ')} data-light-1={artwork.light[1].join(' ')} role={decorative?'presentation':'img'} aria-hidden={decorative?'true':undefined} focusable="false" aria-labelledby={decorative?undefined:`${uid}-title`} aria-describedby={decorative?undefined:`${uid}-desc`}>
{!decorative&&<><title id={`${uid}-title`}>{artwork.imageTitle}</title><desc id={`${uid}-desc`}>{artwork.imageDescription}</desc></>}
<defs><filter id={`${uid}-shadow`} x="-20%" y="-20%" width="140%" height="150%" color-interpolation-filters="sRGB"><feDropShadow data-material-shadow="" dx="3" dy="8" stdDeviation="5" flood-color="#172443" flood-opacity=".16" /></filter><radialGradient id={`${uid}-light`} data-material-light="" gradientUnits="userSpaceOnUse" cx={x} cy={y} r={r}><stop offset="0" stop-color="white" stop-opacity=".9"/><stop offset=".45" stop-color="white" stop-opacity=".48"/><stop offset="1" stop-color="white" stop-opacity="0"/></radialGradient><mask id={`${uid}-illumination`} maskUnits="userSpaceOnUse" x="0" y="0" width="640" height="500" style="mask-type:alpha"><rect width="640" height="500" fill={`url(#${uid}-light)`}/></mask></defs>
<g class="material-sculpture" filter={`url(#${uid}-shadow)`}><g class="material-base"><image x="30" y="52" width="580" height="387" href={asset(320)} preserveAspectRatio="xMidYMid meet"/></g><g class="material-light" mask={`url(#${uid}-illumination)`} aria-hidden="true"><image x="30" y="52" width="580" height="387" href={asset(320)} preserveAspectRatio="xMidYMid meet"/></g></g>
{!decorative&&<text class="material-fallback" x="320" y="250" text-anchor="middle" aria-hidden="true">Illustration unavailable</text>}
</svg>
<style>
  .material-fallback{display:none;fill:currentColor;font:24px var(--ui,sans-serif)}
  :global(.js) .material-print[data-art-state="loading"] .material-sculpture,
  .material-print[data-art-state="failed"] .material-sculpture{visibility:hidden}
  .material-print[data-art-state="failed"]:not([data-art-decorative="true"]) .material-fallback{display:block}
</style>
