---
import { env } from 'cloudflare:workers';
import { getPostBySlug } from '../../../lib/db';
import { publicUrl } from '../../../shared/public/routes';

const { slug } = Astro.params;
if (!slug) return Astro.redirect(publicUrl('writing') + Astro.url.search, 308);

// A missing or unpublished piece must remain a real 404, not a successful redirect.
const post = await getPostBySlug(env.DB, slug);
if (!post) return Astro.rewrite('/404');
return Astro.redirect(publicUrl('post', post.slug) + Astro.url.search, 308);
---
