---
import { env } from "cloudflare:workers";
import BaseLayout from '../../../../site/layouts/BaseLayout.astro';
import EssayContent from '../../../../site/components/EssayContent.astro';
import { getEditorDocument } from '../../../../lib/editor/database';
import { previewDocument } from '../../../../lib/editor/markdown';
import { EditorError } from '../../../../lib/editor/validation';
const { id } = Astro.params;
if (!id) return Astro.redirect('/admin');

let model;
try {
  model = await getEditorDocument(env.DB, id);
} catch (error) {
  if (error instanceof EditorError && error.status === 404) {
    return new Response('Not found', { status: 404 });
  }
  throw error;
}
const rendered = previewDocument(model.document);
---
<BaseLayout title={`${model.document.title||'Untitled'} — Private preview`} description="Private preview" noindex={true} preview={true} bodyClass="essay-page">
<div class="preview-notice">Private saved draft preview · <a href={`/admin/posts/${id}/edit`}>Return to editor</a></div>
<EssayContent title={model.document.title||'Untitled'} html={rendered.renderedHtml} minutes={rendered.readingMinutes} date={model.publishedAt} preview={true} />
</BaseLayout>
