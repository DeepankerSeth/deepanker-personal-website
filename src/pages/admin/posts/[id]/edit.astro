---
import { env } from "cloudflare:workers";
import PostEditor from '../../../../components/editor/PostEditor.astro';
import { getEditorDocument } from '../../../../lib/editor/database';
const { id } = Astro.params;
if (!id) return Astro.redirect('/admin');
let initial;
try {
  initial = await getEditorDocument(env.DB, id);
} catch (error) {
  if (error && typeof error === 'object' && 'status' in error && error.status === 404) return new Response('This piece could not be found.', { status: 404, headers: { 'Cache-Control': 'private, no-store' } });
  throw error;
}
---
<PostEditor initial={initial} />
