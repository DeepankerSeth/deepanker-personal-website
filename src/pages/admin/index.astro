---
import { env } from "cloudflare:workers";
import EditorLayout from '../../components/editor/EditorLayout.astro';
import { listEditorPosts } from '../../lib/editor/database';
const posts = await listEditorPosts(env.DB);
const publishedCount = posts.filter((post) => post.publicationStatus === 'published').length;
const date = (value: string) => new Date(value).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' });
---
<EditorLayout title="Your writing">
  <div class="library-heading">
    <div><p class="room-eyebrow">Private workspace</p><h1>Your writing.</h1><p class="library-intro">{posts.length} {posts.length === 1 ? 'piece' : 'pieces'}. {publishedCount} published. Room for the next.</p></div>
    <a class="room-button room-button-primary" href="/admin/posts/new">New piece <span aria-hidden="true">↗</span></a>
  </div>
  {posts.length ? (
    <section class="room-library" aria-label="All writing">
      <div class="library-controls">
        <label class="library-search" for="find-writing"><span class="sr-only">Find a piece by title or topic</span><input id="find-writing" type="search" placeholder="Find a piece…" /></label>
        <div class="library-filters" role="group" aria-label="Filter writing"><button class="room-filter" data-filter="all" aria-pressed="true">All</button><button class="room-filter" data-filter="private" aria-pressed="false">Private</button><button class="room-filter" data-filter="published" aria-pressed="false">Published</button></div>
      </div>
      <p class="library-count" id="library-count" role="status">{posts.length} {posts.length === 1 ? 'piece' : 'pieces'}</p>
      <div class="library-list">
        {posts.map((post) => (
          <article class="library-row" data-post-row data-status={post.publicationStatus === 'published' ? 'published' : 'private'} data-search={`${post.title} ${post.tags.join(' ')}`.toLowerCase()}>
            <div class="library-row-main"><a class="library-title" href={`/admin/posts/${post.id}/edit`}>{post.title || 'Untitled piece'}</a><div class="library-row-meta"><span class:list={['room-status', { 'is-live': post.publicationStatus === 'published' }]}>{post.publicationStatus === 'published' ? 'Published' : 'Private draft'}</span>{post.hasConflict ? <span class="library-attention">Version needs attention</span> : post.hasUnpublishedChanges && post.publicationStatus === 'published' ? <span>Unpublished changes</span> : null}{post.tags.length > 0 && <span class="library-topics">{post.tags.join(' · ')}</span>}</div></div>
            <div class="library-row-aside"><span>Saved {date(post.savedAt)}</span><a href={`/admin/posts/${post.id}/edit`} aria-label={`Edit ${post.title || 'untitled piece'}`}>Continue <span aria-hidden="true">↗</span></a></div>
          </article>
        ))}
      </div>
      <p id="library-no-results" class="library-empty" hidden>No pieces match. Try another title or topic.</p>
    </section>
  ) : <section class="library-empty"><h2>A thought starts here.</h2><p>Write in the editor or bring a Markdown file. Everything starts as a private draft.</p><a class="room-button" href="/admin/posts/new">Begin a piece</a></section>}
</EditorLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#find-writing');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-post-row]'));
  let status = 'all';
  function filter() {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    let visible = 0;
    for (const row of rows) { row.hidden = !(status === 'all' || row.dataset.status === status) || !row.dataset.search?.includes(query); if (!row.hidden) visible++; }
    const count = document.querySelector('#library-count');
    if (count) count.textContent = `${visible} ${visible === 1 ? 'piece' : 'pieces'}`;
    const empty = document.querySelector<HTMLElement>('#library-no-results');
    if (empty) empty.hidden = visible > 0;
  }
  search?.addEventListener('input', filter);
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => button.addEventListener('click', () => {
    status = button.dataset.filter ?? 'all';
    document.querySelectorAll('[data-filter]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    filter();
  }));
</script>
