---
import EditorLayout from '../../components/editor/EditorLayout.astro';
const returningToEditor = Astro.url.searchParams.get('return') === 'editor';
---
<EditorLayout title="Sign in" authenticated={false}>
  <section class="room-login" data-return-to-editor={String(returningToEditor)}>
    <p class="room-eyebrow">Private workspace</p>
    <h1>Back to the writing.</h1>
    <p class="login-intro">{returningToEditor ? 'Sign in here, then return to your open editor. Your writing will still be there.' : 'Enter your password to open the writing room.'}</p>
    <form id="login-form">
      <label class="room-field" for="password"><span>Password</span><input type="password" id="password" name="password" required autocomplete="current-password" autofocus aria-describedby="login-error" /></label>
      <p id="login-error" class="login-error" role="alert" hidden></p>
      <button type="submit" class="room-button room-button-primary">Sign in <span aria-hidden="true">↗</span></button>
    </form>
    <div id="login-success" class="editor-notice" role="status" hidden><p>You’re signed in. Return to your editor tab and save your writing.</p><a href="/admin">Or open all writing →</a></div>
  </section>
</EditorLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#login-form')!;
  const password = document.querySelector<HTMLInputElement>('#password')!;
  const error = document.querySelector<HTMLElement>('#login-error')!;
  const button = form.querySelector<HTMLButtonElement>('button')!;
  let submitting = false;
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submitting) return;
    submitting = true; error.hidden = true; password.removeAttribute('aria-invalid'); button.disabled = true; button.textContent = 'Signing in…';
    try {
      const response = await fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: password.value }) });
      const result: { error?: string } = await response.json().catch(() => ({}));
      if (!response.ok) {
        error.textContent = response.status === 401 ? 'That password didn’t match. Please try again.' : response.status === 429 ? 'Too many attempts. Wait a moment before trying again.' : result.error || 'Sign-in is unavailable right now. Please try again.';
        error.hidden = false; password.setAttribute('aria-invalid', 'true'); password.focus();
      } else {
        password.value = '';
        if (document.querySelector<HTMLElement>('[data-return-to-editor]')?.dataset.returnToEditor === 'true') {
          form.hidden = true; document.querySelector<HTMLElement>('#login-success')!.hidden = false;
        } else window.location.assign('/admin');
      }
    } catch { error.textContent = 'The connection failed. Please try again when you’re back online.'; error.hidden = false; }
    finally { submitting = false; button.disabled = false; button.textContent = 'Sign in ↗'; }
  });
</script>
